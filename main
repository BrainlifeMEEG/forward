#!/bin/bash
#PBS -l nodes=1:ppn=1,vmem=20gb,walltime=02:00:00
#PBS -N bl.forward

#SBATCH --ntasks-per-node=1
#SBATCH --mem=20G
#SBATCH --time=02:00:00

set -e
set -x

if [ -n "$FS_LICENSE" ] && [ -f "$FS_LICENSE" ]; then
    cp "$FS_LICENSE" license.txt
elif [ -n "$FREESURFER_LICENSE" ]; then
    echo $FREESURFER_LICENSE > license.txt
else
    # This app runs no FreeSurfer binary - it only uses MNE - so a missing
    # license must not fail the job. Write a placeholder so the bind below
    # still has a file to mount.
    echo "No FREESURFER_LICENSE or FS_LICENSE set; continuing (not needed by this app)"
    : > license.txt
fi

singularity --silent exec \
  -B `pwd`/license.txt:/opt/freesurfer/license.txt \
  docker://brainlifemeeg/mne-freesurfer:1.12.1-7.4.1 \
  python3 main.py
